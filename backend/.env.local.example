NODE_ENV=development
PORT=3000
TRUSTED_PROXY_IPS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=copy_the_local_SECRET_KEY_from_supabase_status
STORAGE_SIGNED_URL_TTL_SECONDS=3600
STORAGE_SIGNED_URL_REFRESH_SKEW_SECONDS=60
PUBLIC_CACHE_MAX_AGE_SECONDS=60
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
ORDER_RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_OPERATION_RATE_LIMIT_WINDOW_MS=60000
ADMIN_OPERATION_RATE_LIMIT_MAX=60
ADMIN_SESSION_MAX_AGE_MS=604800000
SECURITY_HMAC_SECRET=local-only-hmac-secret-change-before-production
RECOVERY_WINDOW_MS=900000
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_CAPTCHA_THRESHOLD=3
RECOVERY_BLOCK_DURATION_MS=1800000
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
VERCEL=0
MP_ENABLED=0
MP_ENVIRONMENT=sandbox
# MP_ACCESS_TOKEN=
# MP_API_BASE_URL=https://api.mercadopago.com
# MP_FRONTEND_ORIGIN=http://localhost:5173
# MP_SUCCESS_URL=https://your-backend-ngrok.ngrok-free.app/api/payments/return/{orderNumber}
# MP_PENDING_URL=https://your-backend-ngrok.ngrok-free.app/api/payments/return/{orderNumber}
# MP_FAILURE_URL=https://your-backend-ngrok.ngrok-free.app/api/payments/return/{orderNumber}
# MP_NOTIFICATION_URL=https://your-ngrok-domain.ngrok-free.app/api/webhooks/mercado-pago
# Required when MP_ENABLED=1; configure provider payment type IDs validated for the seller account.
# Include credit_card and ticket (plus any other validated offline types).
# MP_EXCLUDED_PAYMENT_TYPE_IDS=credit_card,ticket
PAYMENT_SCHEDULER_APPROVED=false
PAYMENT_SCHEDULER_HTTP_SUPPORTED=false
PAYMENT_SCHEDULER_PLAN=supabase_free
PAYMENT_SCHEDULER_PROVIDER=disabled
PAYMENT_SCHEDULER_QUOTA_PER_HOUR=0
PAYMENT_WORKER_CADENCE_SECONDS=60
PAYMENT_WORKER_ENABLED=false
PAYMENT_WORKER_SCHEDULER_ENABLED=true
