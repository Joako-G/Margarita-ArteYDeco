{
  "name": "margarita-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:local": "node --env-file=.env.local dist/server.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "node --env-file=.env --import tsx src/integration-tests/public-api.integration.ts",
    "test:integration:local": "node --env-file=.env.local --import tsx src/integration-tests/public-api.integration.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "axios": "1.19.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.10"
  }
}
